APP_ENV=dev
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:5173
APP_VERSION=dev

DATABASE_URL=postgres://archiva:archiva@localhost:5432/archiva
DATABASE_POOL_MAX=10
VALKEY_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=replace-me
OPENSEARCH_INDEX_PREFIX=archiva-dev
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=archiva
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true

CLAMAV_HOST=localhost
CLAMAV_PORT=3310
GOTENBERG_URL=http://localhost:3001
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL_CLASSIFY=claude-sonnet-5
AI_MODEL_TAG=claude-haiku-4-5-20251001
AI_DAILY_TOKEN_BUDGET=1000000
OCR_PROVIDER=fixture
OCR_API_KEY=

AUTH_SECRET=replace-me-with-at-least-32-bytes-of-random
