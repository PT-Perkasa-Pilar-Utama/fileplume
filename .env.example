APP_ENV=dev
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:5173
APP_VERSION=dev

DATABASE_URL=postgres://archiva:archiva@localhost:5432/archiva
DATABASE_POOL_MAX=10
VALKEY_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=replace-me
OPENSEARCH_INDEX_PREFIX=archiva-dev
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=archiva
S3_ACCESS_KEY_ID=archiva
S3_SECRET_ACCESS_KEY=archiva-secret
S3_FORCE_PATH_STYLE=true

# Datastore credentials. Compose creates Postgres and MinIO with these and
# builds the in-network URLs for api, worker and migrate from them.
# Production has no default: generate each with `openssl rand -hex 24`.
POSTGRES_PASSWORD=archiva
MINIO_ROOT_USER=archiva
MINIO_ROOT_PASSWORD=archiva-secret

CLAMAV_HOST=localhost
CLAMAV_PORT=3310
GOTENBERG_URL=http://localhost:3001
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL_CLASSIFY=claude-sonnet-5
AI_MODEL_TAG=claude-haiku-4-5-20251001
AI_DAILY_TOKEN_BUDGET=1000000
OCR_PROVIDER=fixture
OCR_API_KEY=

AUTH_SECRET=replace-me-with-at-least-32-bytes-of-random
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_IDLE_TTL_HOURS=8
# COOKIE_DOMAIN removed: __Host- prefix forbids a Domain attribute.

ENABLE_RESET_API=true
RESET_API_TOKEN=dev-reset-token
RESET_DEFAULT_SEED=dev
HEALTH_TOKEN=dev-health-token

# An empty endpoint disables export locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLER_ARG=1.0

WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_MS=5000
