{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@archiva/shared": ["./packages/shared/src/index.ts"],
      "@archiva/config": ["./packages/config/src/index.ts"],
      "@archiva/db": ["./packages/db/src/index.ts"],
      "@archiva/tenancy": ["./packages/tenancy/src/index.ts"],
      "@archiva/identity": ["./packages/identity/src/index.ts"],
      "@archiva/catalog": ["./packages/catalog/src/index.ts"],
      "@archiva/classification": ["./packages/classification/src/index.ts"],
      "@archiva/enrichment": ["./packages/enrichment/src/index.ts"],
      "@archiva/search": ["./packages/search/src/index.ts"],
      "@archiva/activity": ["./packages/activity/src/index.ts"],
      "@archiva/platform": ["./packages/platform/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "**/migrations/**"]
}
