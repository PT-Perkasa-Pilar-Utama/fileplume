{
  "name": "archiva",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up -d postgres opensearch valkey minio minio-init clamav gotenberg && bun run --filter '*' dev",
    "stack:up": "docker compose up -d --build --wait",
    "check:compose": "bun run scripts/check_compose.ts",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:e2e": "playwright test",
    "build": "bun run --filter './apps/*' build",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:seed:dev": "bun run packages/db/src/seeds/dev.ts",
    "db:seed:qa": "bun run packages/db/src/seeds/qa.ts",
    "complete-check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "7.0.2",
    "lefthook": "2.1.12",
    "@types/bun": "1.4.2"
  }
}
